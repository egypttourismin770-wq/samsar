{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samsar",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "include": ["index.html", "admin/index.html", "sitemap.xml"],
    "run_worker_first": false,
    "not_found_handling": "single-page-application"
  }
}
